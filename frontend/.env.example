# Cermin Saku frontend environment (Monad)

# WalletConnect / Reown project ID. Required for WalletConnect (mobile + QR)
# wallets. Get a free ID at https://cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Privy app id (public). Set it to sign in with Google / email / a wallet, with an
# embedded wallet created on login; leave empty to use RainbowKit's wallet connect.
NEXT_PUBLIC_PRIVY_APP_ID=

# 10143 = Monad testnet (default), 143 = Monad mainnet.
NEXT_PUBLIC_CHAIN_ID=10143
# Optional RPC override. Defaults to testnet-rpc.monad.xyz / rpc.monad.xyz.
NEXT_PUBLIC_MONAD_RPC_URL=
# Optional: comma-separated block numbers holding the demo vault's defend/skim
# events (Monad's public RPC serves logs 100 blocks at a time).
NEXT_PUBLIC_LEDGER_BLOCKS=

# From contracts/script/Deploy.s.sol output. TODO: fill after deploy.
NEXT_PUBLIC_CERMIN_FACTORY_ADDRESS=
NEXT_PUBLIC_MUSD_ADDRESS=
NEXT_PUBLIC_SAVINGS_VAULT_ADDRESS=
NEXT_PUBLIC_PRICE_FEED_ADDRESS=
