# Cermin Saku keeper (Cermin keeper + Saku releaseDue) — copy to .env and fill PRIVATE_KEY + addresses.
# Monad: testnet (10143) by default; CHAIN_ID=143 + mainnet RPC for mainnet.
# 10143 = Monad testnet, 143 = Monad mainnet, 31337 = local Anvil rehearsal
CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Mainnet: MONAD_RPC_URL=https://rpc.monad.xyz

# Keeper signer (funds gas + triggers skim/defend). NEVER commit a real key.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# From contracts/script/Deploy.s.sol output (TODO: fill after deploy).
CERMIN_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
PRICE_FEED_ADDRESS=0x0000000000000000000000000000000000000000

# ── Cermin Saku ───────────────────────────────────────────────────────────
# CerminSaku contract (from the deploy JSON). Unset = only skim/defend run.
SAKU_ADDRESS=
# A held allowance is recorded on-chain at most once per schedule per this
# many ms (evidence, not spam). Demo: 300000 (5 min). Default 30 min.
SAKU_HOLD_COOLDOWN_MS=1800000
# On-time mode (default true): wake when the next allowance falls due on the
# chain's clock, release SAKU_DUE_SLACK_MS after it; re-check a held one every
# SAKU_RECHECK_MS.
SAKU_ON_TIME=true
SAKU_DUE_SLACK_MS=600
SAKU_RECHECK_MS=15000

# Optional — unused while hints are 0x0 (MVP). Safe to omit.
# SORTED_TROVES_ADDRESS=

POLL_INTERVAL_MS=600000
DB_PATH=./data/cermin.db
LOG_LEVEL=info

# ── Keeper safety / health ──────────────────────────────────────────────────
# Warn when the signer's gas (MON) balance drops below this many wei (1e15 =
# 0.001 MON). Low gas means skim/defend silently fail — a missed defend can let
# a vault liquidate, so this surfaces it loudly.
GAS_WARN_THRESHOLD_WEI=1000000000000000
HEALTH_PORT=8080
CYCLE_TIMEOUT_MS=300000

# ── Savings-yield simulation (testnet) ──────────────────────────────────────
# The mock savings vault has no fee source, so the keeper drips a small,
# timestamp-proportional amount each window to mirror a ~5% APR. The signer
# must hold MUSD (MockMUSD on testnet) + MON for gas.
YIELD_ENABLED=false
YIELD_APR_BPS=500
MUSD_ADDRESS=
SAVINGS_VAULT_ADDRESS=
YIELD_MIN_INTERVAL_MS=3600000
YIELD_MAX_CATCHUP_MS=86400000
